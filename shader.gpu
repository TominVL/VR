// ================== VERTEX SHADER =====================
var vertexShaderSource = `
attribute vec3 aVertex;
attribute vec3 aNormal;
uniform mat4 uMVP;
uniform mat4 uMV;
uniform vec3 uLightPos;
varying vec3 vN;
varying vec3 vL;
varying vec3 vP;
void main(){
  vec4 pv = uMV * vec4(aVertex, 1.0);
  vP = pv.xyz;
  vN = normalize((uMV * vec4(aNormal, 0.0)).xyz);
  vL = normalize((uMV * vec4(uLightPos, 1.0)).xyz - pv.xyz);
  gl_Position = uMVP * vec4(aVertex, 1.0);
}`;

// ================== FRAGMENT SHADER =====================
var fragmentShaderSource = `
precision mediump float;
varying vec3 vN;
varying vec3 vL;
varying vec3 vP;
uniform vec3 uColor;
void main(){
  vec3 N = normalize(vN);
  vec3 L = normalize(vL);
  vec3 V = normalize(-vP);
  vec3 R = reflect(-L, N);
  float diff = max(dot(N, L), 0.0);
  float spec = pow(max(dot(R, V), 0.0), 32.0) * step(0.001, diff);
  vec3 col = uColor * (0.2 + 0.7 * diff) + vec3(0.5) * spec;
  gl_FragColor = vec4(col, 1.0);
}`;

// ================== WEBCAM VERTEX SHADER =====================
var camVertexShaderSource = `
attribute vec2 aPos;
varying vec2 vUV;
void main(){
  vUV = aPos * 0.5 + 0.5;
  gl_Position = vec4(aPos, 0.0, 1.0);
}`;

// ================== WEBCAM FRAGMENT SHADER =====================
// Flip vertically: use (1.0 - vUV.y) to correct upside-down webcam
var camFragmentShaderSource = `
precision mediump float;
varying vec2 vUV;
uniform sampler2D uTex;
void main(){
  gl_FragColor = texture2D(uTex, vec2(vUV.x, 1.0 - vUV.y));
}`;
